<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>The Spice Bistro — Reservations</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#f4ece1;
    --ink-soft:rgba(244,236,225,.62);
    --ink-faint:rgba(244,236,225,.34);
    --bg:#0e0a09;
    --panel:rgba(255,255,255,.045);
    --line:rgba(244,236,225,.12);
    --gold:#d8b26a;
    --gold-hi:#f0d8a4;
    --maroon:#7a2231;
    --serif:'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    --sans:'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  *{box-sizing:border-box;}

  html,body{height:100%;}

  body{
    margin:0;
    background:var(--bg);
    color:var(--ink);
    font-family:var(--sans);
    font-weight:300;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    padding:calc(28px + env(safe-area-inset-top,0px)) 16px calc(28px + env(safe-area-inset-bottom,0px));
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
  }

  /* ---------- ambient background ---------- */
  .aurora{
    position:fixed;
    inset:-30%;
    z-index:-2;
    background:
      radial-gradient(38% 42% at 22% 28%, rgba(122,34,49,.55), transparent 62%),
      radial-gradient(34% 38% at 78% 24%, rgba(216,178,106,.22), transparent 64%),
      radial-gradient(44% 46% at 60% 82%, rgba(122,34,49,.34), transparent 66%);
    filter:blur(30px);
    animation:drift 26s ease-in-out infinite alternate;
  }
  @keyframes drift{
    0%{transform:translate3d(-2%,-1%,0) scale(1);}
    50%{transform:translate3d(2%,2%,0) scale(1.06);}
    100%{transform:translate3d(-1%,3%,0) scale(1.02);}
  }

  .grain{
    position:fixed; inset:0; z-index:-1; pointer-events:none; opacity:.4;
    background-image:radial-gradient(rgba(255,255,255,.05) 1px, transparent 1px);
    background-size:3px 3px;
  }

  /* ---------- masthead ---------- */
  .masthead{
    width:100%; max-width:520px; text-align:center;
    margin-bottom:26px;
    animation:rise .9s cubic-bezier(.16,1,.3,1) both;
  }

  .crest{
    display:inline-flex; align-items:center; gap:10px;
    font-size:10.5px; letter-spacing:.34em; text-transform:uppercase;
    color:var(--gold); margin-bottom:16px;
  }
  .crest::before,.crest::after{
    content:""; width:34px; height:1px;
    background:linear-gradient(90deg,transparent,var(--gold));
  }
  .crest::after{background:linear-gradient(270deg,transparent,var(--gold));}

  .masthead h1{
    font-family:var(--serif);
    font-size:clamp(34px,7.5vw,50px);
    font-weight:500; letter-spacing:.01em;
    margin:0; line-height:1.06;
    background:linear-gradient(100deg,var(--ink) 18%,var(--gold-hi) 42%,var(--gold) 52%,var(--ink) 74%);
    background-size:220% 100%;
    -webkit-background-clip:text; background-clip:text;
    -webkit-text-fill-color:transparent;
    animation:sheen 7s ease-in-out infinite;
  }
  @keyframes sheen{
    0%,100%{background-position:120% 0;}
    50%{background-position:-20% 0;}
  }

  .masthead p{
    margin:14px auto 0; max-width:360px;
    font-size:13.5px; line-height:1.6; color:var(--ink-soft);
  }

  /* ---------- card ---------- */
  .card{
    position:relative;
    width:100%; max-width:520px;
    background:linear-gradient(180deg, rgba(255,255,255,.055), rgba(255,255,255,.02));
    border:1px solid var(--line);
    border-radius:24px;
    backdrop-filter:blur(18px);
    -webkit-backdrop-filter:blur(18px);
    box-shadow:0 40px 90px -50px rgba(0,0,0,.95), inset 0 1px 0 rgba(255,255,255,.08);
    overflow:hidden;
    animation:rise 1s .12s cubic-bezier(.16,1,.3,1) both;
  }
  @keyframes rise{
    from{opacity:0; transform:translateY(22px);}
    to{opacity:1; transform:none;}
  }

  .card::before{
    content:""; position:absolute; top:0; left:0; right:0; height:1px;
    background:linear-gradient(90deg,transparent,var(--gold),transparent);
    background-size:44% 100%; background-repeat:no-repeat;
    animation:trace 6s linear infinite;
    opacity:.8;
  }
  @keyframes trace{
    0%{background-position:-50% 0;}
    100%{background-position:150% 0;}
  }

  .bar{
    display:flex; align-items:center; justify-content:space-between;
    padding:15px 20px; border-bottom:1px solid var(--line);
  }

  .bar .title{
    font-family:var(--serif); font-size:17px; letter-spacing:.06em;
  }

  .status{display:inline-flex; align-items:center; gap:7px; font-size:11px; letter-spacing:.09em; text-transform:uppercase; color:var(--ink-faint);}
  .status .dot{width:6px; height:6px; border-radius:50%; background:#5f7f63; box-shadow:0 0 0 0 rgba(95,127,99,.6);}
  .status.busy .dot{background:var(--gold); animation:ping 1.3s ease-out infinite;}
  .status.error .dot{background:#b5495c;}
  @keyframes ping{
    0%{box-shadow:0 0 0 0 rgba(216,178,106,.55);}
    70%{box-shadow:0 0 0 7px rgba(216,178,106,0);}
    100%{box-shadow:0 0 0 0 rgba(216,178,106,0);}
  }

  /* ---------- transcript ---------- */
  #log{
    height:352px; overflow-y:auto; scroll-behavior:smooth;
    padding:22px 20px; display:flex; flex-direction:column; gap:11px;
  }
  #log::-webkit-scrollbar{width:5px;}
  #log::-webkit-scrollbar-thumb{background:rgba(244,236,225,.14); border-radius:99px;}

  .msg{
    max-width:80%; padding:11px 15px; font-size:14px; line-height:1.55;
    border-radius:16px; white-space:pre-wrap;
    animation:pop .5s cubic-bezier(.16,1,.3,1) both;
  }
  @keyframes pop{
    from{opacity:0; transform:translateY(10px) scale(.97);}
    to{opacity:1; transform:none;}
  }

  .msg.bot{
    align-self:flex-start; border-bottom-left-radius:5px;
    background:rgba(255,255,255,.055); border:1px solid var(--line);
  }
  .msg.user{
    align-self:flex-end; border-bottom-right-radius:5px;
    background:linear-gradient(135deg,var(--maroon),#5a1725);
    border:1px solid rgba(216,178,106,.24);
    color:#fdf6ec;
  }

  .typing{
    align-self:flex-start; display:inline-flex; gap:5px;
    padding:14px 16px; border-radius:16px; border-bottom-left-radius:5px;
    background:rgba(255,255,255,.055); border:1px solid var(--line);
    animation:pop .4s both;
  }
  .typing i{width:5px; height:5px; border-radius:50%; background:var(--gold); opacity:.5; animation:bob 1.1s infinite;}
  .typing i:nth-child(2){animation-delay:.15s;}
  .typing i:nth-child(3){animation-delay:.3s;}
  @keyframes bob{
    0%,60%,100%{transform:translateY(0); opacity:.4;}
    30%{transform:translateY(-4px); opacity:1;}
  }

  /* ---------- start action ---------- */
  .start-row{padding:0 20px 16px; display:flex; justify-content:center;}
  .start-row.hidden{display:none;}

  .reserve{
    position:relative; overflow:hidden;
    border:1px solid rgba(216,178,106,.45);
    background:linear-gradient(120deg, rgba(216,178,106,.14), rgba(216,178,106,.05));
    color:var(--gold-hi);
    font-family:var(--sans); font-size:12px; letter-spacing:.22em; text-transform:uppercase;
    padding:13px 30px; border-radius:999px; cursor:pointer;
    transition:transform .2s cubic-bezier(.16,1,.3,1), box-shadow .3s, border-color .3s;
  }
  .reserve:hover{transform:translateY(-1px); border-color:var(--gold); box-shadow:0 12px 30px -14px rgba(216,178,106,.6);}
  .reserve:active{transform:scale(.97);}
  .reserve::after{
    content:""; position:absolute; top:0; bottom:0; width:42%;
    background:linear-gradient(90deg,transparent,rgba(255,255,255,.22),transparent);
    transform:skewX(-18deg);
    animation:gleam 3.6s ease-in-out infinite;
  }
  @keyframes gleam{
    0%{left:-55%;} 55%{left:115%;} 100%{left:115%;}
  }

  /* ---------- composer ---------- */
  .composer{
    border-top:1px solid var(--line);
    padding:14px 16px calc(14px + env(safe-area-inset-bottom,0px));
    display:flex; align-items:center; gap:10px;
  }

  #textInput{
    flex:1; min-width:0;
    background:rgba(255,255,255,.04);
    border:1px solid var(--line);
    border-radius:999px; padding:12px 18px;
    color:var(--ink); font-family:var(--sans); font-size:14px; font-weight:300;
    outline:none; transition:border-color .25s, background .25s;
  }
  #textInput::placeholder{color:var(--ink-faint);}
  #textInput:focus{border-color:rgba(216,178,106,.5); background:rgba(255,255,255,.06);}
  #textInput:disabled{opacity:0.45; cursor:not-allowed;}

  button.round{
    width:44px; height:44px; flex-shrink:0;
    border-radius:50%; border:1px solid var(--line);
    display:inline-flex; align-items:center; justify-content:center;
    cursor:pointer; background:rgba(255,255,255,.05); color:var(--ink);
    transition:transform .16s cubic-bezier(.16,1,.3,1), background .25s, border-color .25s, color .25s;
  }
  button.round:hover:not(:disabled){border-color:rgba(216,178,106,.5); color:var(--gold-hi);}
  button.round:active:not(:disabled){transform:scale(.92);}
  button.round:disabled{opacity:0.35; cursor:not-allowed;}

  #sendBtn{background:linear-gradient(135deg,var(--maroon),#5a1725); border-color:rgba(216,178,106,.3); color:#fdf6ec;}

  #micBtn.listening{
    background:linear-gradient(135deg,var(--gold),#c1954c); color:#1a110c; border-color:transparent;
    animation:halo 1.5s ease-out infinite;
  }
  @keyframes halo{
    0%{box-shadow:0 0 0 0 rgba(216,178,106,.45);}
    70%{box-shadow:0 0 0 12px rgba(216,178,106,0);}
    100%{box-shadow:0 0 0 0 rgba(216,178,106,0);}
  }

  .footnote{
    margin-top:18px; font-size:11px; letter-spacing:.14em; text-transform:uppercase;
    color:var(--ink-faint); text-align:center;
    animation:rise 1.1s .25s both;
  }

  /* ---------- confirmation modal ---------- */
  .modal-backdrop{
    position:fixed; inset:0; z-index:100;
    background:rgba(0,0,0,0.78);
    backdrop-filter:blur(14px);
    -webkit-backdrop-filter:blur(14px);
    display:flex; align-items:center; justify-content:center;
    padding:20px;
    opacity:0; pointer-events:none;
    transition:opacity .35s ease;
  }
  .modal-backdrop.active{ opacity:1; pointer-events:auto; }

  .modal-card{
    background:linear-gradient(180deg, #1d1314, #120c0d);
    border:1px solid rgba(216,178,106,.4);
    border-radius:24px;
    padding:32px 24px;
    width:100%; max-width:420px;
    text-align:center;
    box-shadow:0 35px 80px rgba(0,0,0,.9);
    transform:scale(0.92);
    transition:transform .35s cubic-bezier(.16,1,.3,1);
  }
  .modal-backdrop.active .modal-card{ transform:scale(1); }

  .modal-badge{
    width:54px; height:54px; margin:0 auto 16px;
    border-radius:50%;
    background:rgba(216,178,106,.15);
    border:1px solid var(--gold);
    display:flex; align-items:center; justify-content:center;
    color:var(--gold-hi);
  }

  .modal-card h2{
    font-family:var(--serif);
    font-size:29px;
    margin:0 0 8px;
    color:var(--gold-hi);
    font-weight:500;
  }

  .modal-summary{
    background:rgba(255,255,255,.04);
    border:1px solid var(--line);
    border-radius:14px;
    padding:16px 18px;
    margin:18px 0;
    font-size:13.5px;
    line-height:1.8;
    text-align:left;
    color:var(--ink-soft);
  }
  .modal-summary strong{ color:var(--ink); font-weight:500; }

  .modal-actions{ display:flex; flex-direction:column; gap:10px; margin-top:20px; }

  .btn-wa{
    display:inline-flex; align-items:center; justify-content:center; gap:8px;
    background:#25D366; color:#0b2415;
    text-decoration:none; font-weight:500; font-size:13px;
    letter-spacing:.04em; padding:13px 20px; border-radius:999px;
    transition:filter .2s, transform .2s;
  }
  .btn-wa:hover{ filter:brightness(1.08); transform:translateY(-1px); }

  .btn-close{
    background:transparent; border:1px solid var(--line);
    color:var(--ink-faint); font-size:12px; letter-spacing:.08em;
    padding:11px; border-radius:999px; cursor:pointer;
    transition:color .2s, border-color .2s;
  }
  .btn-close:hover{ color:var(--ink); border-color:var(--gold); }

  @media (max-width:430px){
    #log{height:300px;}
    .msg{max-width:88%;}
  }

  @media (prefers-reduced-motion: reduce){
    *{animation:none !important; transition:none !important;}
  }
</style>
</head>
<body>

<div class="aurora"></div>
<div class="grain"></div>

<header class="masthead">
  <div class="crest">The Spice Bistro</div>
  <h1>Reserve your table</h1>
  <p>Tell us the date, the hour and how many will be joining you. We'll hold the table.</p>
</header>

<main class="card">
  <div class="bar">
    <div class="title">Reservations</div>
    <div class="status" id="status"><span class="dot"></span><span id="statusText">Ready</span></div>
  </div>

  <div id="log"></div>

  <div class="start-row" id="startRow">
    <button class="reserve" id="reserveBtn">Begin reservation</button>
  </div>

  <div class="composer">
    <button class="round" id="micBtn" title="Speak">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 15a3 3 0 003-3V6a3 3 0 10-6 0v6a3 3 0 003 3z" stroke="currentColor" stroke-width="1.6"/><path d="M19 11a7 7 0 01-14 0M12 18v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
    <input type="text" id="textInput" placeholder="Type your reply…" autocomplete="off">
    <button class="round" id="sendBtn" title="Send">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M4 12l16-8-6 16-3-7-7-1z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" fill="currentColor"/></svg>
    </button>
  </div>
</main>

<div class="footnote">Open daily · 11:30 – 23:00</div>

<!-- Confirmation Popup Modal -->
<div class="modal-backdrop" id="confirmModal">
  <div class="modal-card">
    <div class="modal-badge">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
    </div>
    <h2>Reservation Confirmed</h2>
    <p style="font-size: 13px; color: var(--ink-soft); margin: 0;">We've reserved your table at The Spice Bistro.</p>
    
    <div class="modal-summary" id="modalSummary"></div>

    <div class="modal-actions">
      <a href="#" target="_blank" class="btn-wa" id="waLink">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2zm5.78 14.07c-.24.68-1.41 1.26-1.95 1.33-.51.07-1.18.1-3.41-.82-2.85-1.18-4.68-4.08-4.82-4.27-.14-.19-1.15-1.53-1.15-2.92 0-1.39.73-2.07 1-2.35.24-.28.53-.35.71-.35.18 0 .36 0 .52.01.17.01.4.06.62.53.24.57.8 1.95.87 2.1.07.14.12.31.02.5-.1.19-.15.31-.3.49-.14.17-.31.38-.44.51-.14.14-.29.29-.12.58.17.29.74 1.22 1.59 1.98 1.09.97 2.01 1.27 2.3 1.41.29.14.46.12.63-.07.17-.19.73-.85.92-1.14.19-.29.38-.24.64-.14.26.1 1.64.77 1.92.91.29.14.48.21.55.33.07.12.07.69-.17 1.37z"/></svg>
        Send to WhatsApp
      </a>
      <button class="btn-close" id="closeModalBtn">Done</button>
    </div>
  </div>
</div>

<script>
  // ==========================================================
  // Deployed Apps Script Web App URL
  // ==========================================================
  const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbzaETiMHBwIH_x79OwEvCB0Aw3A19d_SKZgSPlej_oIkReTHpd5Bmw30FA-P5yIF0Y7/exec";

  const LANG = "en";
  const LOCALE = "en-US";

  let state = "idle";
  let context = {};
  let jsonpCounter = 0;

  const logEl         = document.getElementById("log");
  const textInput     = document.getElementById("textInput");
  const sendBtn       = document.getElementById("sendBtn");
  const micBtn        = document.getElementById("micBtn");
  const statusEl      = document.getElementById("status");
  const statusText    = document.getElementById("statusText");
  const startRow      = document.getElementById("startRow");
  const reserveBtn    = document.getElementById("reserveBtn");
  const confirmModal  = document.getElementById("confirmModal");
  const modalSummary  = document.getElementById("modalSummary");
  const waLink        = document.getElementById("waLink");
  const closeModalBtn = document.getElementById("closeModalBtn");

  const GREETING = "Good day, and welcome to The Spice Bistro. I can hold a table for you — shall we begin?";

  const AFFIRMATIVE = /^(y|ya|yes|yep|yeah|yup|sure|ok|okay|please|yes please|go ahead|start|book|booking|reserve|reservation|i want to book|table)\b[\s.!,]*$/i;

  function normalise(text){
    if(state === "idle" && AFFIRMATIVE.test(text.trim())) return "book a table";
    return text;
  }

  function addMessage(text, who){
    const div = document.createElement("div");
    div.className = "msg " + who;
    div.textContent = text;
    logEl.appendChild(div);
    logEl.scrollTop = logEl.scrollHeight;
    return div;
  }

  function showTyping(){
    const t = document.createElement("div");
    t.className = "typing";
    t.innerHTML = "<i></i><i></i><i></i>";
    logEl.appendChild(t);
    logEl.scrollTop = logEl.scrollHeight;
    return t;
  }

  function setStatus(mode, label){
    statusEl.className = "status " + mode;
    statusText.textContent = label;
  }

  function speak(text){
    if(!("speechSynthesis" in window)) return;
    const u = new SpeechSynthesisUtterance(text);
    u.lang = LOCALE;
    u.rate = 0.98;
    window.speechSynthesis.cancel();
    window.speechSynthesis.speak(u);
  }

  function escapeHtml(str) {
    return String(str || "").replace(/[&<>"']/g, function(m){
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
    });
  }

  function showConfirmationPopup(booking) {
    modalSummary.innerHTML = `
      <div><strong>Name:</strong> ${escapeHtml(booking.name)}</div>
      <div><strong>Guests:</strong> ${escapeHtml(booking.guests)}</div>
      <div><strong>Date & Time:</strong> ${escapeHtml(booking.datetime)}</div>
      <div><strong>Phone:</strong> ${escapeHtml(booking.phone)}</div>
    `;

    // Format phone: digits only, default India country code (91) if 10 digits
    let rawPhone = (booking.phone || "").replace(/[^\d]/g, "");
    if (rawPhone.length === 10) {
      rawPhone = "91" + rawPhone;
    }

    const waText = encodeURIComponent(
      `*The Spice Bistro — Table Reservation*\n\n` +
      `Hello ${booking.name},\n` +
      `Your table reservation is confirmed!\n\n` +
      `• Guests: ${booking.guests}\n` +
      `• Date & Time: ${booking.datetime}\n` +
      `• Contact: ${booking.phone}\n\n` +
      `We look forward to welcoming you!`
    );

    waLink.href = `https://wa.me/${rawPhone}?text=${waText}`;
    confirmModal.classList.add("active");
  }

  function closeConversation() {
    confirmModal.classList.remove("active");
    // Lock controls to terminate flow
    textInput.disabled = true;
    textInput.placeholder = "Reservation complete. Have a wonderful meal!";
    sendBtn.disabled = true;
    micBtn.disabled = true;
    startRow.classList.add("hidden");
    setStatus("ready", "Closed");
  }

  closeModalBtn.addEventListener("click", closeConversation);

  // JSONP call — sidesteps CORS with Apps Script
  function callBackend(text){
    return new Promise((resolve, reject) => {
      const cbName = "__bistroCb" + (jsonpCounter++);
      const script = document.createElement("script");
      let done = false;

      const cleanup = () => { delete window[cbName]; script.remove(); };

      window[cbName] = (data) => { done = true; cleanup(); resolve(data); };
      script.onerror = () => { done = true; cleanup(); reject(new Error("Network error")); };

      const params = new URLSearchParams({
        text, state,
        context: JSON.stringify(context),
        lang: LANG,
        callback: cbName
      });

      script.src = SCRIPT_URL + "?" + params.toString();
      document.body.appendChild(script);

      setTimeout(() => { if(!done){ cleanup(); reject(new Error("Timed out")); } }, 15000);
    });
  }

  async function sendMessage(raw){
    const text = (raw || "").trim();
    if(!text) return;

    startRow.classList.add("hidden");
    addMessage(text, "user");
    textInput.value = "";
    setStatus("busy", "Checking");
    const typing = showTyping();

    try{
      const data = await callBackend(normalise(text));
      typing.remove();
      state   = data.nextState || "idle";
      context = data.context || {};
      addMessage(data.reply, "bot");
      speak(data.reply);
      setStatus("ready", "Ready");

      // Check backend trigger for completion
      if (data.isConfirmed && data.booking) {
        setTimeout(() => {
          showConfirmationPopup(data.booking);
        }, 1100);
      }
    }catch(err){
      typing.remove();
      console.error(err);
      addMessage("I couldn't reach our reservations desk just now. Please try again in a moment.", "bot");
      setStatus("error", "Offline");
    }
  }

  sendBtn.addEventListener("click", () => sendMessage(textInput.value));
  textInput.addEventListener("keydown", (e) => { if(e.key === "Enter") sendMessage(textInput.value); });
  reserveBtn.addEventListener("click", () => sendMessage("Book a table"));

  // ---------- voice input (Chrome / Edge / Safari) ----------
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  let recognizer = null, listening = false;

  if(SR){
    recognizer = new SR();
    recognizer.continuous = false;
    recognizer.interimResults = false;
    recognizer.lang = LOCALE;

    recognizer.onresult = (e) => sendMessage(e.results[0][0].transcript);
    recognizer.onend = () => { listening = false; micBtn.classList.remove("listening"); };
    recognizer.onerror = () => { listening = false; micBtn.classList.remove("listening"); };

    micBtn.addEventListener("click", () => {
      if(listening){ recognizer.stop(); return; }
      try{
        recognizer.start();
        listening = true;
        micBtn.classList.add("listening");
      }catch(_){}
    });
  }else{
    micBtn.disabled = true;
    micBtn.style.opacity = ".35";
    micBtn.title = "Voice input not supported in this browser";
  }

  // ---------- opening line ----------
  setTimeout(() => addMessage(GREETING, "bot"), 420);
</script>

</body>
</html>
